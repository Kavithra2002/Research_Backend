# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- SMTP (Password reset emails) ---
# Examples:
#   Gmail (requires App Password):  SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_SECURE=false
#   SendGrid:                       SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey   SMTP_PASS=<API key>
#   Mailgun:                        SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
#   Brevo (Sendinblue):             SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# Leave blank to keep dev-mode console logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ambeon Console <no-reply@yourdomain.com>"

# --- Resend (recommended for production / Render — more reliable than Gmail SMTP) ---
# https://resend.com/api-keys — free tier works for demos
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Ambeon Console <onboarding@resend.dev>

# --- MongoDB ---
# Standalone Mongo running on localhost:27017 (as shown in MongoDB Compass).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=Research_Project

# DB table columns: 0 = stay on 2017–2025 baseline; 1 = auto-add columns when new-year data is saved
COMB_YEAR_AUTO_EXTEND=0

# --- OpenAI (Sage agent + Python extraction pipeline) ---
# Same key is read by the Node backend (Sage chat) and the Python extractor.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model for RAG vector search (stored in MongoDB `document_chunks`).
# text-embedding-3-small is cheap + 1536 dims. Build the index with:
#   npm run rag:ingest
OPENAI_EMBED_MODEL=text-embedding-3-small

# Organization Admin key (starts with sk-admin-...) used ONLY for the read-only
# Costs API that powers the sidebar "spend" widget. Create one at:
#   https://platform.openai.com/settings/organization/admin-keys
# Leave blank to disable the spend widget. The regular OPENAI_API_KEY will NOT
# work here — the Costs endpoint requires an admin key.
OPENAI_ADMIN_KEY=

# Manual credit-balance snapshot for the sidebar "remaining" figure.
# OpenAI has NO API for the live credit balance, so record the balance shown in
# your dashboard and the date it was accurate. The widget subtracts real spend
# since that date (via the admin key above) to show a live remaining estimate.
# Update OPENAI_CREDIT_BALANCE_AS_OF to today's date each time you top up.
#   OPENAI_CREDIT_BALANCE=14.97
#   OPENAI_CREDIT_BALANCE_AS_OF=2026-06-08   (YYYY-MM-DD, treated as UTC)
OPENAI_CREDIT_BALANCE=
OPENAI_CREDIT_BALANCE_AS_OF=

# --- Storage (local dev = disk; production on Render = r2 for Python PDF download) ---
STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ambeon-demo
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Paths inside Docker (set on Render)
# SCRIPT_ROOT=/app
# SCRIPT_DIR=/app/scripts
# PYTHON_BIN=python3
