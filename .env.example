# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- SMTP (Password reset emails) ---
# Examples:
#   Gmail (requires App Password):  SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_SECURE=false
#   SendGrid:                       SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey   SMTP_PASS=<API key>
#   Mailgun:                        SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
#   Brevo (Sendinblue):             SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# Leave blank to keep dev-mode console logging.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ambeon Console <no-reply@yourdomain.com>"

# --- MongoDB ---
# Standalone Mongo running on localhost:27017 (as shown in MongoDB Compass).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=Research_Project

# --- OpenAI (Sage agent + Python extraction pipeline) ---
# Same key is read by the Node backend (Sage chat) and the Python extractor.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
